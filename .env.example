# ==========================================================
# CONFIGURAÇÃO DO BANCO DE DADOS POSTGRESQL - AVALIA AB (EXEMPLO)
# ==========================================================
# Renomeie este arquivo para .env e preencha com suas configurações

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=sua_senha_aqui
POSTGRES_DB=avalia_ab

# Opcional: URL direta de conexão (sobrescreve os campos acima se preenchida)
# DATABASE_URL=postgresql://postgres:sua_senha@127.0.0.1:5432/avalia_ab

# Chave criptográfica de assinatura de sessão (gere uma chave aleatória e segura)
AVALIA_SECRET_KEY=gere_uma_chave_secreta_aleatoria_aqui

